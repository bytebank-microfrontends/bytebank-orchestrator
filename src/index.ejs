<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%
    const productionCsp = [
      "default-src 'self'",
      "script-src 'self' 'unsafe-inline' https://bytebank-microfrontends.github.io https://cdn.jsdelivr.net",
      "connect-src 'self'",
      "style-src 'self' 'unsafe-inline'",
      "img-src 'self' data: https://bytebank-microfrontends.github.io",
      "font-src 'self' data:",
      "object-src 'none'",
      "base-uri 'self'",
      "form-action 'self'",
    ].join("; ");

    const localCsp = [
      "default-src 'self' localhost:*",
      "script-src 'self' 'unsafe-inline' localhost:* https://cdn.jsdelivr.net",
      "connect-src 'self' localhost:* ws://localhost:*",
      "style-src 'self' 'unsafe-inline'",
      "img-src 'self' data: localhost:* https://bytebank-microfrontends.github.io",
      "font-src 'self' data:",
      "object-src 'none'",
      "base-uri 'self'",
      "form-action 'self'",
    ].join("; ");
  %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>ByteBank</title>
  <meta http-equiv="Content-Security-Policy" content="<%= isLocal ? localCsp : productionCsp %>">
  <meta name="importmap-type" use-injector />
  <link
    rel="icon"
    type="image/png"
    href="https://bytebank-microfrontends.github.io/bytebank-orchestrator/bytebank-symbol.png"
  />
  <meta name="theme-color" content="#17121f" />

  <!-- Shared dependencies go into this import map -->
  <script type="injector-importmap">
    {
      "imports": {
        "single-spa": "https://cdn.jsdelivr.net/npm/single-spa@6.0.3/lib/es2015/esm/single-spa.min.js",
        "react": "https://cdn.jsdelivr.net/npm/react@19.2.5/+esm",
        "react/jsx-runtime": "https://cdn.jsdelivr.net/npm/react@19.2.5/jsx-runtime/+esm",
        "react/jsx-dev-runtime": "https://cdn.jsdelivr.net/npm/react@19.2.5/jsx-dev-runtime/+esm",
        "react-dom": "https://cdn.jsdelivr.net/npm/react-dom@19.2.5/+esm",
        "react-dom/client": "https://cdn.jsdelivr.net/npm/react-dom@19.2.5/client/+esm"
      }
    }
  </script>
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/single-spa@6.0.3/lib/es2015/esm/single-spa.min.js" as="module">

  <!-- Add your organization's prod import map URL to this script's src  -->
  <!-- <script type="injector-importmap" src="/importmap.json"></script> -->

  <% if (isLocal) { %>
  <script type="injector-importmap">
    {
      "imports": {
        "@bytebank/root-config": "//localhost:9000/bytebank-root-config.js",
        "@bytebank/account": "//localhost:8500/bytebank-account.js",
        "@bytebank/auth": "//localhost:8081/bytebank-auth.js",
        "@bytebank/navbar": "//localhost:8501/bytebank-navbar.js",
        "@bytebank/not-found": "//localhost:8502/bytebank-not-found.js",
        "@bytebank/dashboard": "//localhost:8503/bytebank-dashboard.js",
        "@bytebank/transaction": "//localhost:8504/bytebank-transaction.js",
        "@bytebank/util": "//localhost:8505/bytebank-util.js",
        "@bytebank/user-widget": "//localhost:8506/bytebank-user-widget.js",
        "@bytebank/cards": "//localhost:8507/bytebank-cards.js"
      }
    }
  </script>
  <% } else { %>
  <script type="injector-importmap">
    {
      "imports": {
        "@bytebank/root-config": "https://bytebank-microfrontends.github.io/bytebank-orchestrator/bytebank-root-config.js",
        "@bytebank/account": "https://bytebank-microfrontends.github.io/bytebank-account/bytebank-account.js",
        "@bytebank/auth": "https://bytebank-microfrontends.github.io/bytebank-auth/bytebank-auth.js",
        "@bytebank/navbar": "https://bytebank-microfrontends.github.io/bytebank-navbar/bytebank-navbar.js",
        "@bytebank/not-found": "https://bytebank-microfrontends.github.io/bytebank-not-found/bytebank-not-found.js",
        "@bytebank/dashboard": "https://bytebank-microfrontends.github.io/bytebank-dashboard/bytebank-dashboard.js",
        "@bytebank/transaction": "https://bytebank-microfrontends.github.io/bytebank-transaction/bytebank-transaction.js",
        "@bytebank/util": "https://bytebank-microfrontends.github.io/bytebank-util/bytebank-util.js",
        "@bytebank/user-widget": "https://bytebank-microfrontends.github.io/bytebank-user-widget/bytebank-user-widget.js",
        "@bytebank/cards": "https://bytebank-microfrontends.github.io/bytebank-cards/bytebank-cards.js"
      }
    }
  </script>
  <% } %>

  <% if (isLocal) { %>
  <script src="https://cdn.jsdelivr.net/npm/import-map-overrides@5.1.1/dist/import-map-overrides.js"></script>
  <% } %>
  <script src="https://cdn.jsdelivr.net/npm/@single-spa/import-map-injector@2.0.1/lib/import-map-injector.js"></script>
</head>
<body>
  <noscript>
    You need to enable JavaScript to run this app.
  </noscript>
  <main></main>
  <script>
    window.importMapInjector.initPromise.then(() => {
      import('@bytebank/root-config');
    });
  </script>
  <% if (isLocal) { %>
  <import-map-overrides-full show-when-local-storage="devtools" dev-libs></import-map-overrides-full>
  <% } %>
</body>
</html>
